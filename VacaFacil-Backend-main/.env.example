# Porta do servidor HTTP
PORT=5000

# Chave secreta para assinar os tokens JWT (use uma string longa e aleatória em produção)
JWT_SECRET=troque_por_uma_chave_secreta_forte

# Tempo de expiração do token JWT (ex: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Origens permitidas pelo CORS, separadas por vírgula
# Em produção, coloque apenas a URL do seu app mobile/web
ALLOWED_ORIGINS=http://localhost:8081

# URL pública da API (usada pelo Swagger em produção)
# Exemplo: https://seu-app.onrender.com
API_URL=http://localhost:5000
